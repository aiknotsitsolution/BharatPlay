# Development builds discover the API host from the Expo dev server.
# For production builds, set this to the public HTTPS API origin.
EXPO_PUBLIC_API_BASE_URL=
# Optional explicit API and Socket.IO origins for local/custom deployments.
API_BASE_URL=
API_SOCKET_BASE_URL=
# Public Google Cloud project number linked to Play Integrity; required for Android signup builds.
EXPO_PUBLIC_PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=669267941865
# Google Sign-In: use OAuth client IDs for the Android package/signing SHA-1,
# iOS bundle ID, and the Web client used to validate ID tokens on the backend.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
