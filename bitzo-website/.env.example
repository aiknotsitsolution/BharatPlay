# Base URL for the API used by the frontend.
# Local gateway: http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Google OAuth client ID for the user-facing website.
# Google sign-in button is hidden when this is empty.
VITE_GOOGLE_CLIENT_ID=

# Public-facing website URL (used in the public site config).
# Optional — falls back to the current browser origin when empty.
VITE_SITE_URL=

# Official Google Play Store listing URL for the BharatPlay Android app.
# Not present in the repository — insert the real URL when published.
# The "/apps" page and home CTA link use this value. Leave empty if unknown.
VITE_GOOGLE_PLAY_URL=

# Official support / contact email shown on public pages.
# Optional — the app shows generic contact channels when empty.
VITE_SUPPORT_EMAIL=
